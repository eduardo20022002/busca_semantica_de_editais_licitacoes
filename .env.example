# Copie este arquivo para .env e preencha com suas próprias chaves.
# Nenhuma chave real deve ser commitada — .env já está no .gitignore.

# Embeddings (Score de triagem e Score de aderência) — https://voyageai.com
VOYAGE_API_KEY=

# Alternativa de embeddings usada em experimentos de comparação — https://ai.google.dev
GEMINI_API_KEY=

# Julgamento por LLM (Veredito de aderência) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Backend que recebe o resultado final do pipeline (Painel de Analistas)
PAINEL_API_URL=https://api.exemplo.com/functions/v1/editais-api
EDITAIS_API_KEY=
